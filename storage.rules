rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAllowedImage() {
      return request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/jpg'
        || request.resource.contentType == 'image/png'
        || request.resource.contentType == 'image/webp';
    }

    function withinSizeLimit() {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /announcements/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && isAllowedImage()
        && withinSizeLimit();
      allow delete: if isOwner(userId);
    }
  }
}
